{
  "$schema": "https://opencanviz.com/schema/v1.json",
  "title": "Idea to video",
  "artboard": {
    "x": -960,
    "y": -540,
    "width": 1920,
    "height": 1080,
    "background": "#0f172a"
  },
  "diagrams": [
    {
      "nodes": [
        {
          "id": "a",
