          "edges": [
            {
              "id": "a_to_b",
              "trim": 1
            }
          ],
          "actions": [
            {
              "type": "edgeTween",
              "target": {
                "kind": "edge",
                "id": "a_to_b"
              },
              "from": {
                "trim": 0
              },
              "to": {
                "trim": 1
              },
              "durationMs": 700,
              "ease": "ease-out"
            },
            {
              "type": "visibility",
              "target": {
                "kind": "node",
                "id": "b"
              },
              "mode": "fadeIn",
              "durationMs": 400,
              "offsetMs": 700
